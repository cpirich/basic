10 REM Number Guessing Game
20 LET N = INT(RND(1) * 100) + 1
30 PRINT "I'M THINKING OF A NUMBER BETWEEN 1 AND 100"
40 LET T = 0
50 LET T = T + 1
60 INPUT "WHAT IS YOUR GUESS"; G
70 IF G = N THEN GOTO 110
80 IF G < N THEN PRINT "TOO LOW"
90 IF G > N THEN PRINT "TOO HIGH"
100 GOTO 50
110 PRINT "YOU GOT IT IN "; T; " TRIES!"
120 END
